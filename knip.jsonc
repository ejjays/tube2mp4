{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["dependencies", "unlisted", "unresolved", "binaries"],
  "ignoreBinaries": ["ffmpeg", "yt-dlp", "kaggle"],
  // web/site is an astro project; knip can't trace .astro entry points,
  // the runtime --require ./userland-shim.cjs (preview script) or the
  // postinstall scripts/binding-fix.mjs. Excluded intentionally rather
  // than maintained as a fragile half-config. Revisit if it stabilizes.
  "ignoreWorkspaces": ["web/site"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      // scripts require.resolve('typescript7/package.json') to locate its
      // bin (ts7's exports map hides bin/); not a real dependency edge
      "ignoreDependencies": ["typescript7/package.json"],
    },
    "packages/extractors": {},
    "packages/web-mux": {},
    "web/api": {
      "vite": false,
      "vitest": false,
      "ignoreDependencies": [
        "pino-pretty",
        // imported only by tests/e2e/browser.e2e.test.ts, which knip's
        // default entry tracing doesn't reach
        "puppeteer-core",
        "playwright-core",
      ],
    },
    "web/app": {
      "entry": ["src/main.tsx"],
      "vite": false,
      "vitest": false,
      "ignoreDependencies": [
        "@playwright/test",
        "@testing-library/jest-dom",
        // test-only: knip's vitest plugin is off, so these look unused
        "@testing-library/dom",
        "@testing-library/react",
        "@vitejs/plugin-react",
        "vite-plugin-sitemap",
      ],
    },
    "mobile": {
      "entry": [
        "tests/**/*.test.{ts,tsx}",
        "supabase/functions/**/index.ts",
        "plugins/*.js",
      ],
      "ignore": ["vitest.config.ts"],
      "ignoreDependencies": [
        "npm",
        "expo-dev-client",
        "expo-navigation-bar",
        "expo-status-bar",
        "expo-updates",
        "expo-blur",
        "expo-video",
      ],
      "vitest": false,
      "expo": false,
    },
  },
}
